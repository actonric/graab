# Fly.io configuration for Graab. Copy to the repository root as fly.toml and
# change the app name and region. See README.md → "Hosting on a server".
#
# Two deployment shapes:
#
#   PRIVATE (recommended): no [http_service] block, so the app has no public
#   address. Reach it from your laptop with `fly proxy 8765:8765 -a <app>` or
#   over Fly's WireGuard network, and point your MCP client at localhost.
#
#   PUBLIC: uncomment [http_service] to get https://<app>.fly.dev. Every request
#   then depends on GRAAB_MCP_TOKEN, so make it long and random, and set
#   GRAAB_MCP_ALLOWED_HOSTS to your hostname.

app = "graab-whatsapp"
primary_region = "iad"

[build]
  dockerfile = "deploy/Dockerfile"

[env]
  GRAAB_STORE_DIR = "/data"
  GRAAB_MCP_TRANSPORT = "http"
  GRAAB_MCP_HOST = "0.0.0.0"
  GRAAB_MCP_PORT = "8765"
  GRAAB_LOG_MESSAGES = "0"
  # Shown under Linked devices on your phone (applied when pairing).
  GRAAB_DEVICE_NAME = "Graab MCP Bridge"
  # Start read-only; flip to "0" once you trust the setup.
  GRAAB_READ_ONLY = "1"
  # Limit who the model may message (comma-separated numbers or JIDs).
  # GRAAB_ALLOWED_RECIPIENTS = "14155551234,120363000000000000@g.us"
  # GRAAB_SEND_RATE = "10"

# Secrets (never in this file):
#   fly secrets set GRAAB_MCP_TOKEN="$(openssl rand -hex 32)"
#   Pairing: open the QR page through a tunnel (see README → Hosting on a server):
#     fly proxy 8765:8765 -a <app>   then   http://127.0.0.1:8765/pair?token=<GRAAB_MCP_TOKEN>
#   or pair by phone code instead:
#     fly secrets set GRAAB_PAIR_PHONE=14155551234   # unset after pairing

[mounts]
  source = "graab_data"
  destination = "/data"
  initial_size = "1gb"

# WhatsApp allows one live connection per linked device: exactly one machine,
# never scaled to zero, never scaled out.
[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"

# --- PRIVATE deployment: leave [http_service] commented out. ---------------
# [http_service]
#   internal_port = 8765
#   force_https = true
#   auto_stop_machines = "off"
#   auto_start_machines = true
#   min_machines_running = 1
#   [http_service.concurrency]
#     type = "requests"
#     hard_limit = 50
#     soft_limit = 25

[checks]
  [checks.mcp]
    type = "http"
    port = 8765
    path = "/healthz"
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
